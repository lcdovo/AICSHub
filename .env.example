# AI Customer 唯一 Docker 部署配置模板。
# 使用方式：复制为 .env，按注释修改后执行 docker compose up -d --build。
# .env 包含密码和 API Key，禁止提交到版本库。

# 应用展示名称；会显示在首页、Swagger 标题和健康检查响应中。
APP_NAME=智能客服系统
# 应用版本号；用于接口元数据和 /health 响应，不影响数据库迁移版本。
APP_VERSION=1.1.0
# 运行环境；完整 Docker 部署使用 integration，production 会启用更严格的安全校验。
ENVIRONMENT=integration
# 调试开关；生产必须为 false，避免输出详细异常和 SQL 调试信息。
DEBUG=false
# 宿主机映射端口；浏览器通过 http://localhost:APP_PORT 访问应用。
APP_PORT=8000
# 容器内监听地址；不要改为 127.0.0.1，否则 Docker 外部无法访问。
HOST=0.0.0.0
# 容器内应用端口；Compose 已固定为 8000，通常不需要修改。
PORT=8000

# MySQL root 管理员密码；首次创建 mysql_data 卷时生效，不能为空。
MYSQL_ROOT_PASSWORD=change-me-root-password
# 应用连接 MySQL 使用的用户名；必须与 MYSQL_APP_PASSWORD 配套。
MYSQL_APP_USER=customer_service
# 应用连接 MySQL 使用的密码；不能为空，建议使用随机字母数字字符串。
MYSQL_APP_PASSWORD=change-me-app-password
# MySQL 初始化时创建的数据库名称；应用连接字符串会引用此名称。
MYSQL_DATABASE=customer_service
# MySQL 主机名；Docker 网络中使用服务名 mysql，不要填写 localhost。
MYSQL_HOST=mysql
# MySQL 对外映射端口；容器间连接仍使用 3306。
MYSQL_PORT=3306

# 是否启用 Redis；完整部署必须为 true，以使用共享会话和限流存储。
REDIS_ENABLED=true
# Redis 主机名；Docker 网络中使用服务名 redis。
REDIS_HOST=redis
# Redis 对外映射端口；容器间连接仍使用 6379。
REDIS_PORT=6379
# Redis 密码；当前 Compose 默认未启用 Redis AUTH，使用外部 Redis 时再填写。
REDIS_PASSWORD=
# Redis 逻辑数据库编号；通常使用 0，多个应用共用 Redis 时可改用其他编号。
REDIS_DB=0

# 是否使用 Milvus 向量检索；完整依赖部署必须为 true。
USE_MILVUS=true
# Milvus 主机名；Docker 网络中使用服务名 milvus。
MILVUS_HOST=milvus
# Milvus gRPC 端口；Compose 中映射为 19530。
MILVUS_PORT=19530

# MinIO 管理员用户名；Milvus 使用同一套 MinIO 服务，但应用通常不直接使用它。
MINIO_ROOT_USER=minioadmin
# MinIO 管理员密码；不能为空，至少 8 个字符，首次创建 minio_data 卷时生效。
MINIO_ROOT_PASSWORD=change-me-minio-password

# JWT 签名密钥；至少 32 个字符，必须使用随机值，修改后旧 Token 会失效。
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# 是否自动创建演示账号；生产环境必须为 false，初始化账号需走管理员流程。
AUTH_DEMO_ACCOUNTS_ENABLED=false
# Access Token 有效期，单位为分钟；范围为 1 到 1440。
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh Token 有效期，单位为天；范围为 1 到 90。
REFRESH_TOKEN_EXPIRE_DAYS=7
# 允许跨域的前端来源，多个来源用逗号分隔；不要在生产使用 *。
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 每个 IP 每分钟允许的登录请求数；用于防止暴力破解。
LOGIN_RATE_LIMIT_PER_MINUTE=10
# 每个用户/IP 每分钟允许的聊天请求数；过小会影响正常对话。
CHAT_RATE_LIMIT_PER_MINUTE=60
# 单条聊天消息最大字符数；超出后接口会拒绝请求。
CHAT_MESSAGE_MAX_LENGTH=5000
# 单个上传文件最大字节数；5242880 等于 5 MiB。
MAX_UPLOAD_FILE_BYTES=5242880
# 单次批量上传允许的文件数量上限。
MAX_BATCH_UPLOAD_FILES=10

# LLM HTTP API 基础地址；程序会在其后拼接供应商的接口路径。
LLM_API_BASE=
# LLM API 密钥；不要提交到版本库或打印到日志。
LLM_API_KEY=
# 使用的 LLM 模型名称；必须是 LLM 服务实际支持的模型。
LLM_MODEL=gpt-4o-mini
# 是否启用 Mock LLM；没有真实 LLM 时可设为 true，但不代表生产能力。
MOCK_LLM_ENABLED=false
# 是否启用 LLM 规划节点；关闭时优先使用规则和确定性路由。
LLM_PLANNING_ENABLED=false
# LLM 单次请求超时时间，单位为秒。
LLM_REQUEST_TIMEOUT_SECONDS=30
# 单次 LLM 请求最大输出 Token 数；范围为 64 到 8192。
LLM_MAX_TOKENS=1024
# LLM 请求失败后的最大重试次数；过大可能增加延迟和费用。
LLM_MAX_RETRIES=2

# Prompt 版本标识；用于 Trace、审计和结果对比，不是模型参数。
LLM_PROMPT_VERSION=v1
# 模型版本标识；应与实际部署模型版本保持一致。
LLM_MODEL_VERSION=gpt-4o-mini
# LLM 结构化响应 Schema 版本；变更响应格式时递增或改名。
LLM_SCHEMA_VERSION=response.v1
# LLM 路由策略版本；用于追踪规则路由和模型路由的变化。
LLM_ROUTE_VERSION=rules-first.v1
# 单次请求允许的最大估算费用，单位为美元。
LLM_MAX_COST_USD=0.05
# 单个用户每日最大 Token 预算；超过后会触发降级或拒绝。
LLM_DAILY_USER_TOKEN_BUDGET=100000
# 单个用户每日最大估算费用，单位为美元。
LLM_DAILY_USER_COST_USD=5
# 输入 Token 价格，单位为美元/1000 Token；按供应商账单调整。
LLM_INPUT_PRICE_PER_1K_USD=0.00015
# 输出 Token 价格，单位为美元/1000 Token；按供应商账单调整。
LLM_OUTPUT_PRICE_PER_1K_USD=0.00060
# LLM 灰度发布比例，取值 0 到 100；100 表示全部请求进入新路由。
LLM_GRAY_ROLLOUT_PERCENT=100

# Embedding API 基础地址；用于把知识库文本转换为向量。
EMBEDDING_API_BASE=
# Embedding API 密钥；为空时会使用内置 Mock Embedding/降级逻辑。
EMBEDDING_API_KEY=
# Embedding 模型名称；向量维度必须与 EMBEDDING_DIM 一致。
EMBEDDING_MODEL=
# Milvus 向量维度；必须与 Embedding 服务实际返回的维度一致。
EMBEDDING_DIM=1024

# Milvus collection 名称；修改后会使用新的向量集合。
COLLECTION_NAME=customer_service_knowledge
# 每次检索最终返回的文档数量。
RAG_TOP_K=5
# 向量相似度最低阈值；低于该值的结果会被过滤。
RAG_SIMILARITY_THRESHOLD=0.2
# BM25 关键词检索在混合检索中的权重。
RAG_BM25_WEIGHT=0.5
# 向量检索在混合检索中的权重；通常与 BM25 权重之和为 1。
RAG_VECTOR_WEIGHT=0.5
# 是否启用结果重排器；true 通常能提升相关性，但会增加计算开销。
RAG_USE_RERANKER=true
# 检索候选集相对于 RAG_TOP_K 的放大倍数，用于混合检索和重排。
RAG_SEARCH_TOP_K_MULTIPLIER=3

# 每个文档分片的目标大小，单位为字符；过大会降低检索粒度。
CHUNK_SIZE=500
# 相邻分片重叠字符数；用于保留跨分片上下文，必须小于 CHUNK_SIZE。
CHUNK_OVERLAP=50
# 分片规则；sentence 按句切分，paragraph 按段落切分。
CHUNK_SPLIT_PATTERN=sentence

# /health 探测外部依赖的超时时间，单位为秒；过小会造成误报，过大影响响应速度。
HEALTHCHECK_TIMEOUT_SECONDS=2
