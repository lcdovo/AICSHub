# Docker 唯一部署配置模板：复制为 .env 后执行 docker compose up
# 不要提交包含真实密码或 API Key 的 .env
ENVIRONMENT=integration
DEBUG=false
APP_PORT=8000
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
AUTH_DEMO_ACCOUNTS_ENABLED=false
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_APP_USER=customer_service
MYSQL_APP_PASSWORD=change-me-app-password
MYSQL_DATABASE=customer_service
MYSQL_PORT=3306
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
USE_MILVUS=true
MILVUS_HOST=milvus
MILVUS_PORT=19530
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
MOCK_LLM_ENABLED=false
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
