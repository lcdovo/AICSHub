# 本地开发 profile：无需 MySQL、Redis、Milvus 或真实 LLM 即可运行
APP_NAME=智能客服系统
APP_VERSION=1.1.0
DEBUG=true
ENVIRONMENT=local
DATABASE_URL_OVERRIDE=sqlite+aiosqlite:///./customer_service.db
USE_MILVUS=false
MOCK_LLM_ENABLED=true
HEALTHCHECK_TIMEOUT_SECONDS=2
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
AUTH_SECRET_KEY=replace-with-a-random-32-byte-secret
AUTH_DEMO_ACCOUNTS_ENABLED=true
DEMO_USER_PASSWORD=user12345
DEMO_ADMIN_PASSWORD=admin12345
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_MINUTE=60
CHAT_MESSAGE_MAX_LENGTH=5000
MAX_UPLOAD_FILE_BYTES=5242880
MAX_BATCH_UPLOAD_FILES=10

# 可选：仅 integration profile 配置真实 LLM（不要提交密钥）
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# 可选外部依赖
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=customer_service
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=false
MILVUS_HOST=localhost
MILVUS_PORT=19530
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# RAG 与分块参数
COLLECTION_NAME=customer_service_knowledge
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.2
RAG_BM25_WEIGHT=0.5
RAG_VECTOR_WEIGHT=0.5
RAG_USE_RERANKER=true
RAG_SEARCH_TOP_K_MULTIPLIER=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHUNK_SPLIT_PATTERN=sentence
