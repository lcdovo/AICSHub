# AI Customer 唯一 Docker 部署配置模板。
# 使用方式：复制为 .env，按注释修改后执行 docker compose up -d --build。
# .env 包含密码和 API Key，禁止提交到版本库。

# 应用展示名称；会显示在首页、Swagger 标题和健康检查响应中。
# APP_VERSION 是应用版本号，用于接口元数据和 /health 响应，不影响数据库迁移版本。
# ENVIRONMENT 使用 integration；production 会启用更严格的安全校验。
# DEBUG 生产必须为 false，避免输出详细异常和 SQL 调试信息。
# APP_PORT 是宿主机映射端口，浏览器通过 http://localhost:APP_PORT 访问应用。
# HOST 是容器内监听地址，不要改为 127.0.0.1，否则 Docker 外部无法访问。
# PORT 是容器内应用端口，Compose 已固定为 8000，通常不需要修改。
APP_NAME=智能客服系统
APP_VERSION=1.1.0
ENVIRONMENT=integration
DEBUG=false
APP_PORT=8000
HOST=0.0.0.0
PORT=8000

# MYSQL_ROOT_PASSWORD 是 MySQL root 管理员密码；首次创建 mysql_data 卷时生效，不能为空。
# MYSQL_APP_USER 和 MYSQL_APP_PASSWORD 是应用连接 MySQL 使用的账号和密码，二者必须配套。
# MYSQL_DATABASE 是初始化时创建的数据库名称；应用连接字符串会引用此名称。
# MYSQL_HOST 在 Docker 网络中使用服务名 mysql，不要填写 localhost。
# MYSQL_PORT 是 MySQL 对外映射端口，容器间连接仍使用 3306。
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_APP_USER=customer_service
MYSQL_APP_PASSWORD=change-me-app-password
MYSQL_DATABASE=customer_service
MYSQL_HOST=mysql
MYSQL_PORT=3306

# REDIS_ENABLED 完整部署必须为 true，以使用共享会话和限流存储。
# REDIS_HOST 在 Docker 网络中使用服务名 redis；REDIS_PORT 容器间连接使用 6379。
# REDIS_PASSWORD 当前 Compose 默认未启用 Redis AUTH，使用外部 Redis 时再填写。
# REDIS_DB 是 Redis 逻辑数据库编号，通常使用 0。
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# USE_MILVUS 完整依赖部署必须为 true，以启用向量检索。
# MILVUS_HOST 在 Docker 网络中使用服务名 milvus。
# MILVUS_PORT 是 Milvus gRPC 端口，Compose 中映射为 19530。
USE_MILVUS=true
MILVUS_HOST=milvus
MILVUS_PORT=19530

# MINIO_ROOT_USER 是 MinIO 管理员用户名，供 Milvus 使用。
# MINIO_ROOT_PASSWORD 是 MinIO 管理员密码，不能为空且至少 8 个字符，首次创建 minio_data 卷时生效。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

# AUTH_SECRET_KEY 是 JWT 签名密钥，至少 32 个字符，必须使用随机值；修改后旧 Token 会失效。
# AUTH_DEMO_ACCOUNTS_ENABLED 控制是否自动创建演示账号，生产环境必须为 false。
# ACCESS_TOKEN_EXPIRE_MINUTES 是 Access Token 有效期（分钟），范围 1 到 1440。
# REFRESH_TOKEN_EXPIRE_DAYS 是 Refresh Token 有效期（天），范围 1 到 90。
# CORS_ALLOW_ORIGINS 是允许跨域的前端来源，多个来源用逗号分隔；生产不要使用 *。
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
AUTH_DEMO_ACCOUNTS_ENABLED=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# LOGIN_RATE_LIMIT_PER_MINUTE 是每个 IP 每分钟允许的登录请求数，用于防止暴力破解。
# CHAT_RATE_LIMIT_PER_MINUTE 是每个用户/IP 每分钟允许的聊天请求数。
# CHAT_MESSAGE_MAX_LENGTH 是单条聊天消息最大字符数，超出后接口会拒绝请求。
# MAX_UPLOAD_FILE_BYTES 是单个上传文件最大字节数，5242880 等于 5 MiB。
# MAX_BATCH_UPLOAD_FILES 是单次批量上传允许的文件数量上限。
LOGIN_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_MINUTE=60
CHAT_MESSAGE_MAX_LENGTH=5000
MAX_UPLOAD_FILE_BYTES=5242880
MAX_BATCH_UPLOAD_FILES=10

# LLM_API_BASE 是 LLM HTTP API 基础地址，程序会在其后拼接供应商接口路径。
# LLM_API_KEY 是 LLM API 密钥，不要提交到版本库或打印到日志。
# LLM_MODEL 是使用的模型名称，必须是 LLM 服务实际支持的模型。
# MOCK_LLM_ENABLED 没有真实 LLM 时可设为 true，但 Mock 结果不代表生产能力。
# LLM_PLANNING_ENABLED 控制是否启用 LLM 规划节点，关闭时优先使用规则路由。
# LLM_REQUEST_TIMEOUT_SECONDS 是单次请求超时时间（秒）。
# LLM_MAX_TOKENS 是单次请求最大输出 Token 数，范围 64 到 8192。
# LLM_MAX_RETRIES 是失败后的最大重试次数，过大可能增加延迟和费用。
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.7-max
MOCK_LLM_ENABLED=false
LLM_PLANNING_ENABLED=false
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
LLM_MAX_RETRIES=2

# LLM_PROMPT_VERSION 是 Prompt 版本标识，用于 Trace、审计和结果对比。
# LLM_MODEL_VERSION 是模型版本标识，应与实际部署模型版本保持一致。
# LLM_SCHEMA_VERSION 是结构化响应 Schema 版本，变更响应格式时递增或改名。
# LLM_ROUTE_VERSION 是 LLM 路由策略版本，用于追踪规则和模型路由变化。
# LLM_MAX_COST_USD 是单次请求允许的最大估算费用（美元）。
# LLM_DAILY_USER_TOKEN_BUDGET 是单个用户每日最大 Token 预算。
# LLM_DAILY_USER_COST_USD 是单个用户每日最大估算费用（美元）。
# LLM_INPUT_PRICE_PER_1K_USD 和 LLM_OUTPUT_PRICE_PER_1K_USD 是输入/输出 Token 的美元单价（每 1000 Token）。
# LLM_GRAY_ROLLOUT_PERCENT 取值 0 到 100，100 表示全部请求进入新路由。
LLM_PROMPT_VERSION=v1
LLM_MODEL_VERSION=gpt-4o-mini
LLM_SCHEMA_VERSION=response.v1
LLM_ROUTE_VERSION=rules-first.v1
LLM_MAX_COST_USD=0.05
LLM_DAILY_USER_TOKEN_BUDGET=100000
LLM_DAILY_USER_COST_USD=5
LLM_INPUT_PRICE_PER_1K_USD=0.00015
LLM_OUTPUT_PRICE_PER_1K_USD=0.00060
LLM_GRAY_ROLLOUT_PERCENT=100

# EMBEDDING_API_BASE 是 Embedding API 基础地址，用于把知识库文本转换为向量。
# EMBEDDING_API_KEY 是 Embedding API 密钥；为空时会使用内置 Mock Embedding/降级逻辑。
# EMBEDDING_MODEL 是 Embedding 模型名称，向量维度必须与 EMBEDDING_DIM 一致。
# EMBEDDING_DIM 是 Milvus 向量维度，必须与 Embedding 服务实际返回的维度一致。
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# COLLECTION_NAME 是 Milvus collection 名称，修改后会使用新的向量集合。
# RAG_TOP_K 是每次检索最终返回的文档数量。
# RAG_SIMILARITY_THRESHOLD 是向量相似度最低阈值，低于该值的结果会被过滤。
# RAG_BM25_WEIGHT 和 RAG_VECTOR_WEIGHT 是关键词/向量检索在混合检索中的权重，通常总和为 1。
# RAG_USE_RERANKER 控制是否启用结果重排器，启用通常能提升相关性但会增加开销。
# RAG_SEARCH_TOP_K_MULTIPLIER 是检索候选集相对于 RAG_TOP_K 的放大倍数。
COLLECTION_NAME=customer_service_knowledge
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.2
RAG_BM25_WEIGHT=0.5
RAG_VECTOR_WEIGHT=0.5
RAG_USE_RERANKER=true
RAG_SEARCH_TOP_K_MULTIPLIER=3

# CHUNK_SIZE 是每个文档分片的目标大小（字符），过大会降低检索粒度。
# CHUNK_OVERLAP 是相邻分片重叠字符数，用于保留跨分片上下文，必须小于 CHUNK_SIZE。
# CHUNK_SPLIT_PATTERN 是分片规则：sentence 按句切分，paragraph 按段落切分。
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHUNK_SPLIT_PATTERN=sentence

# HEALTHCHECK_TIMEOUT_SECONDS 是 /health 探测外部依赖的超时时间（秒）。
HEALTHCHECK_TIMEOUT_SECONDS=2
