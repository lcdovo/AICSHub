# AI Customer 唯一 Docker 部署配置模板。
# 使用方式：复制为 .env，按注释修改后执行 docker compose up -d --build。
# .env 包含密码和 API Key，禁止提交到版本库。
# 本文件是安全起步模板，不镜像任何开发机/已部署实例的运行配置；实际生效值以容器内
# app.config.config.settings 为准。默认使用规则理解、Judge v1 和保守超时；切换策略需单独验收。

# 应用展示名称；会显示在首页、Swagger 标题和健康检查响应中。
# APP_VERSION 是应用版本号，用于接口元数据和 /health 响应，不影响数据库迁移版本。
# ENVIRONMENT 使用 integration；production 会启用更严格的安全校验。
# DEBUG 生产必须为 false，避免输出详细异常和 SQL 调试信息。
# APP_PORT 是宿主机映射端口，浏览器通过 http://localhost:APP_PORT 访问应用。
# HOST 是容器内监听地址，不要改为 127.0.0.1，否则 Docker 外部无法访问。
# PORT 是容器内应用端口，Compose 已固定为 8000，通常不需要修改。
# APP_WORKERS 是 uvicorn 多 worker 数：进程无状态（会话/锁/checkpoint 在 Redis），
# 并发上来后按 CPU 核数横向扩容；DEBUG=false 时生效。
APP_NAME=智能客服系统
APP_VERSION=1.1.0
ENVIRONMENT=integration
DEBUG=false
APP_WORKERS=1
WORKERS=1
APP_PORT=8100
HOST=0.0.0.0
PORT=8100

# MYSQL_ROOT_PASSWORD 是 MySQL root 管理员密码；首次创建 mysql_data 卷时生效，不能为空。
# MYSQL_APP_USER 和 MYSQL_APP_PASSWORD 是应用连接 MySQL 使用的账号和密码，二者必须配套。
# MYSQL_DATABASE 是初始化时创建的数据库名称；应用连接字符串会引用此名称。
# MYSQL_HOST 在 Docker 网络中使用服务名 mysql，不要填写 localhost。
# MYSQL_PORT 是 MySQL 对外映射端口，容器间连接仍使用 3306。
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_APP_USER=customer_service
MYSQL_APP_PASSWORD=change-me-app-password
DEMO_USER_PASSWORD=change-me-demo-user-password
DEMO_ADMIN_PASSWORD=change-me-demo-admin-password
MYSQL_DATABASE=customer_service
MYSQL_HOST=mysql
MYSQL_PORT=3306

# REDIS_ENABLED 完整部署必须为 true，以使用共享会话和限流存储。
# REDIS_HOST 在 Docker 网络中使用服务名 redis；REDIS_PORT 容器间连接使用 6379。
# REDIS_PASSWORD 当前 Compose 默认未启用 Redis AUTH，使用外部 Redis 时再填写。
# REDIS_DB 是 Redis 逻辑数据库编号，通常使用 0。
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# USE_MILVUS 完整依赖部署必须为 true，以启用向量检索。
# MILVUS_HOST 在 Docker 网络中使用服务名 milvus。
# MILVUS_PORT 是 Milvus gRPC 端口，Compose 中映射为 19530。
USE_MILVUS=true
MILVUS_HOST=milvus
MILVUS_PORT=19530

# MINIO_ROOT_USER 是 MinIO 管理员用户名，供 Milvus 使用。
# MINIO_ROOT_PASSWORD 是 MinIO 管理员密码，不能为空且至少 8 个字符，首次创建 minio_data 卷时生效。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

# AUTH_SECRET_KEY 是 JWT 签名密钥，至少 32 个字符，必须使用随机值；修改后旧 Token 会失效。
# AUTH_DEMO_ACCOUNTS_ENABLED 控制是否自动创建演示账号，生产环境必须为 false。
# ACCESS_TOKEN_EXPIRE_MINUTES 是 Access Token 有效期（分钟），范围 1 到 1440。
# REFRESH_TOKEN_EXPIRE_DAYS 是 Refresh Token 有效期（天），范围 1 到 90。
# CORS_ALLOW_ORIGINS 是允许跨域的前端来源，多个来源用逗号分隔；生产不要使用 *。
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
AUTH_DEMO_ACCOUNTS_ENABLED=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ALLOW_ORIGINS=http://localhost:8100,http://127.0.0.1:8100

# LOGIN_RATE_LIMIT_PER_MINUTE 是每个 IP 每分钟允许的登录请求数，用于防止暴力破解。
# CHAT_RATE_LIMIT_PER_MINUTE 是每个用户/IP 每分钟允许的聊天请求数。
# CHAT_MESSAGE_MAX_LENGTH 是单条聊天消息最大字符数，超出后接口会拒绝请求。
# MAX_UPLOAD_FILE_BYTES 是单个上传文件最大字节数，5242880 等于 5 MiB。
# MAX_BATCH_UPLOAD_FILES 是单次批量上传允许的文件数量上限。
LOGIN_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_MINUTE=60
CHAT_MESSAGE_MAX_LENGTH=5000
MAX_UPLOAD_FILE_BYTES=5242880
MAX_BATCH_UPLOAD_FILES=10

# LLM_API_BASE 是 LLM HTTP API 基础地址，程序会在其后拼接供应商接口路径。
# LLM_API_KEY 是 LLM API 密钥，不要提交到版本库或打印到日志。
# LLM_MODEL 是使用的模型名称，必须是 LLM 服务实际支持的模型。
# LLM_REQUEST_TIMEOUT_SECONDS 是单次请求超时时间（秒）。
# LLM_MAX_TOKENS 是单次请求最大输出 Token 数，范围 64 到 8192。
# LLM_MAX_RETRIES 是失败后的最大重试次数，过大可能增加延迟和费用。
LLM_API_BASE=https://token.uino.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# DeepSeek 兼容接口的思考开关；空值不发送 thinking 参数。
LLM_THINKING_MODE=disabled
# UINO deepseek-flash 不支持 json_schema，使用工具调用返回结构化结果。
LLM_STRUCTURED_OUTPUT_METHOD=function_calling
# 备用模型（provider 容灾）：需同时配置 BASE 与 MODEL 才会启用备份链路；
# 主模型（LLM_API_BASE/LLM_MODEL）不可用时自动切换。留空 = 不启用备份。
LLM_BACKUP_BASE=
LLM_BACKUP_KEY=
LLM_BACKUP_MODEL=
# 解析型任务本地模型（意图识别+问题重写专用，vLLM 部署，见 docker-compose.yml，
# 需 NVIDIA GPU + WSL2/Docker GPU）：base+model 同时配置才启用；启用后
# classify_intent / 查询改写优先走本地，失败回退主链（LLM_API_*）。
# judge 与回复生成始终走主链（外接），不受影响。
LLM_LOCAL_BASE=
LLM_LOCAL_MODEL=
# 默认由主模型完成意图识别与改写。本地 Qwen 需显式启动并配置才启用：
# LLM_LOCAL_BASE=http://llm-local:8001/v1（Docker）；本机开发使用 http://localhost:8011/v1
# LLM_LOCAL_KEY=local
# LLM_LOCAL_MODEL=qwen3-4b-awq
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048
LLM_MAX_RETRIES=0
LLM_UNDERSTANDING_MAX_TOKENS=500
LLM_GATEWAY_ENABLED=false
LLM_PRICE_VERIFIED=false
LLM_INTENT_PRIMARY=false

# LLM_PROMPT_VERSION 是 Prompt 版本标识，用于 Trace、审计和结果对比。
# LLM_MODEL_VERSION 是模型版本标识，应与实际部署模型版本保持一致。
# LLM_SCHEMA_VERSION 是结构化响应 Schema 版本，变更响应格式时递增或改名。
# LLM_ROUTE_VERSION 是 LLM 路由策略版本，用于追踪规则和模型路由变化。
# LLM_MAX_COST_USD 是单次请求允许的最大估算费用（美元）。
# LLM_DAILY_USER_TOKEN_BUDGET 是单个用户每日最大 Token 预算。
# LLM_DAILY_USER_COST_USD 是单个用户每日最大估算费用（美元）。
# LLM_INPUT_PRICE_PER_1K_USD 和 LLM_OUTPUT_PRICE_PER_1K_USD 是输入/输出 Token 的美元单价（每 1000 Token）。
LLM_PROMPT_VERSION=v1
LLM_MODEL_VERSION=deepseek-flash
LLM_SCHEMA_VERSION=response.v1
LLM_ROUTE_VERSION=rules-first.v1
LLM_MAX_COST_USD=0.05
LLM_DAILY_USER_TOKEN_BUDGET=100000
LLM_DAILY_USER_COST_USD=5
LLM_INPUT_PRICE_PER_1K_USD=0.00015
LLM_OUTPUT_PRICE_PER_1K_USD=0.00060

# ---- LLM 参与决策增强开关（Phase 3+）----
# LLM_QUERY_REWRITE_ENABLED 控制规则改写未命中时，是否由模型做多轮语义改写以增强 RAG 召回。
# LLM_JUDGE_ENABLED 控制是否启用 LLM-as-judge 对 RAG/工具回答做事实与引用一致性校验（防幻觉），
# 无法锚定证据时选择"无据不答"而非编造；LLM 不可用时自动退化为启发式校验。
# USER_MEMORY_ENABLED 控制是否启用长期记忆 / 用户画像（聚合当前关系库历史，可选向量召回）。
# USER_MEMORY_MAX_ITEMS 是注入 LLM 提示词的用户历史最大条数，范围 0 到 50。
LLM_QUERY_REWRITE_ENABLED=true
LLM_JUDGE_ENABLED=true
# 此模板默认Judge v1。候选/已部署实例可以显式覆盖，不从本模板推断当前运行配置。
LLM_JUDGE_CONTRACT_VERSION=v1
# v2协议仅在契约v2时生效；供应商协议失败不会自动切换或重试。
LLM_JUDGE_V2_OUTPUT_PROTOCOL=function_calling
LLM_JUDGE_SEGMENT_WIRE=false
USER_MEMORY_ENABLED=true
USER_MEMORY_MAX_ITEMS=5
# 用户历史向量召回最低余弦相似度；模型切换后需重新校准。
USER_MEMORY_MIN_SIMILARITY=0.65

# ---- MCP 工具协议（可选，默认开启）----
# 工具层通过 FastMCP server 暴露为标准 MCP 协议：agent 内经 MCP client 调用，
# 亦可被任意 MCP Host 复用。MCP client 不可用时自动回退进程内直调。
# MCP_TRANSPORT: inprocess（同进程内存传输，默认）| stdio（子进程隔离）。
# stdio 模式下以 `python -m <MCP_SERVER_ENTRY>` 拉起子进程。
MCP_ENABLED=true
MCP_TRANSPORT=inprocess
MCP_SERVER_ENTRY=app.agent.mcp_server

# ---- OpenTelemetry（可观测，默认 sdk-only）----
# 设置 OTEL_EXPORTER_OTLP_ENDPOINT（如 http://jaeger:4318）后，
# span 以 OTLP 协议导出到任意 OTel 后端；留空仅进程内生成 span。
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Langfuse 外部 LLM 观测（可选，默认关闭）----
# 通过 LangGraph CallbackHandler 上报 Agent 执行轨迹（token 成本/延迟/prompt 版本），
# 与自研 tracking 为互补关系。需同时配置 key 且 LANGFUSE_ENABLED=true 才会生效。
# 两种接入方式：
#   1) 自托管（推荐，数据不出内网）：docker compose -f docker-compose.yml -f docker-compose.langfuse.yml up -d
#      或 scripts\start.ps1 -Langfuse。首次启动会用 LANGFUSE_INIT_* 自动创建项目与管理员，
#      项目 public/secret key 即下方 LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY。
#   2) Langfuse Cloud：在控制台 Settings -> API Keys 生成，LANGFUSE_HOST 留空。
# LANGFUSE_HOST 本地/非 Docker 运行填 http://localhost:3000；Docker 内由 compose 覆盖为 http://langfuse:3000。
# LANGFUSE_SAMPLING_RATE 采样率（0.0-1.0），生产高并发建议调低以控制成本。
# 注意：上报内容含 prompt 与工具入参，接入前确认数据合规与脱敏策略。
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_SAMPLING_RATE=1

# ---- Langfuse 自托管栈专用配置（仅 docker-compose.langfuse.yml 使用）----
# LANGFUSE_ADMIN_* 是控制台管理员账号（首次启动自动创建，登录 http://localhost:3000）。
# LANGFUSE_DB_PASSWORD / LANGFUSE_CLICKHOUSE_PASSWORD 是自托管栈的数据库密码。
# 密钥生成：
#   LANGFUSE_NEXTAUTH_SECRET: openssl rand -base64 32
#   LANGFUSE_SALT: openssl rand -base64 32
#   LANGFUSE_ENCRYPTION_KEY: openssl rand -hex 32（必须是 64 位十六进制）
# 自托管项目 key 需与 LANGFUSE_INIT_PROJECT_PUBLIC_KEY / LANGFUSE_INIT_PROJECT_SECRET_KEY 对应，
# 因此 LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY 必须先填好（格式 pk-lf-xxx / sk-lf-xxx），
# compose 会把它们注入初始化，实现首次启动即可用、无需进控制台手工建项目。
LANGFUSE_ADMIN_EMAIL=admin@ai-customer.local
LANGFUSE_ADMIN_USERNAME=admin
LANGFUSE_ADMIN_PASSWORD=change-me-admin-password
LANGFUSE_DB_PASSWORD=change-me-langfuse-db-password
LANGFUSE_CLICKHOUSE_PASSWORD=change-me-langfuse-clickhouse-password
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=

# EMBEDDING_API_BASE 是 Embedding API 基础地址，用于把知识库文本转换为向量。
# EMBEDDING_API_KEY 是 Embedding API 密钥；为空时会使用内置 Mock Embedding/降级逻辑。
# EMBEDDING_MODEL 是 Embedding 模型名称，向量维度必须与 EMBEDDING_DIM 一致。
# EMBEDDING_DIM 是 Milvus 向量维度，必须与 Embedding 服务实际返回的维度一致。
# EMBEDDING_BATCH_SIZE 是单次请求文本条数上限：默认 20 兼容 DashScope 等外接 API；
# 本地 Ollama 无此限制，建议调大（如 64）减少批量入库的 HTTP 往返次数。
# EMBEDDING_QUERY_INSTRUCTION 是查询侧指令前缀（Qwen3-Embedding 等指令感知模型
# 建议启用，如"为这个句子生成表示以用于检索相关文章："）；检索时自动加前缀，
# 文档入库侧不加；留空保持原行为。
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=1
EMBEDDING_QUERY_INSTRUCTION=
EMBEDDING_REVISION=unspecified

# ---- Reranker 重排服务（模型 reranker，可选）----
# 重排优先级：外部 API → 本地 bge-reranker-large → 启发式加权（_heuristic_rescore）。
# 外部 API（openai 风格）：RERANKER_API_BASE 指向兼容 POST {base}/rerank 的服务
#   （Cohere 兼容，如 Jina/ SiliconFlow/ InfiniFlow），body {model,query,documents,top_n}。
#   DashScope 用户将 RERANKER_API_STYLE=dashscope，端点自动变为
#   {base}/services/rerank/text-rerank/generation。
# 本地部署：RERANKER_LOCAL_BASE 指向 Infinity 容器（见 docker-compose.reranker.yml，
#   .\scripts\start.ps1 -Reranker），默认模型 BAAI/bge-reranker-large。
# 都不配置时 RAG_USE_RERANKER 自动回退启发式重排，不影响检索主链路。
RERANKER_API_BASE=
RERANKER_API_KEY=
RERANKER_MODEL=
RERANKER_API_STYLE=openai
RERANKER_TIMEOUT_SECONDS=3
RERANKER_LOCAL_BASE=
RERANKER_LOCAL_MODEL=BAAI/bge-reranker-large

# 默认Compose同时运行API与Job worker，须共用Redis DB及namespace协调本地模型。
# Redis失联时拒绝准入；仅独立运行单进程且不启动索引Worker时才考虑process。
LOCAL_MODEL_COORDINATOR=redis
LOCAL_MODEL_MAX_CONCURRENCY=1
# 本地重排候选批大小；默认4。只有完成本地GPU/API/Worker组合容量验收后才调大。
RERANKER_LOCAL_BATCH_SIZE=4
LOCAL_MODEL_COORDINATOR_NAMESPACE=aicshub:local-models:whole-v1

# COLLECTION_NAME 是 Milvus collection 名称，修改后会使用新的向量集合。
# RAG_TOP_K 是每次检索最终返回的文档数量。
# RAG_SIMILARITY_THRESHOLD 是向量相似度最低阈值，低于该值的结果会被过滤。
# RAG_USE_RERANKER 控制是否启用结果重排器，启用通常能提升相关性但会增加开销。
# 注：混合检索融合已改为 RRF（依赖排名而非权重），不再提供 RAG_BM25_WEIGHT /
# RAG_VECTOR_WEIGHT / RAG_SEARCH_TOP_K_MULTIPLIER。
COLLECTION_NAME=customer_service_knowledge
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.2
RAG_USE_RERANKER=true
RAG_RECALL_K=20
RAG_RERANK_K=20
# RRF平滑常数；证据预算为含标题上下文的字符数，片段不截断。
RAG_RRF_K=60
RAG_EVIDENCE_MAX_CHARS=8000
# 0关闭邻块补全；1/2在同章节或同FAQ内补取相邻原文片段，计入TOP_K和字符预算。
RAG_CONTEXT_NEIGHBORS=1

# CHUNK_SIZE 是原文分片的字符硬上限（不含检索上下文），最小64。
# CHUNK_OVERLAP 是相邻分片重叠字符数，用于保留跨分片上下文，必须小于 CHUNK_SIZE。
# 标题层级和FAQ是结构边界；heading/paragraph优先段落和整行，sentence优先句末，fixed固定窗口。
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHUNK_SPLIT_PATTERN=heading

# HEALTHCHECK_TIMEOUT_SECONDS 是 /health 探测外部依赖的超时时间（秒）。
HEALTHCHECK_TIMEOUT_SECONDS=2

# 持久退款预览有效期，单位秒；新预览默认15分钟
REFUND_ACTION_TTL_SECONDS=900

# 模板默认使用rules兼容路径；model表示启用结构化模型理解，百分比控制稳定灰度范围。
# 切换前按当前代码、模型供应商和业务验收材料完成准入；不要把开发机运行值复制为通用默认。
REQUEST_UNDERSTANDING_MODE=rules
REQUEST_UNDERSTANDING_PERCENTAGE=0
REQUEST_UNDERSTANDING_VERSION=understanding.v1
# 任务循环模板默认关闭；启用前须检查数据库迁移、依赖开关和当前版本的完整准入证据。
AGENT_TASK_LOOP_ENABLED=false
AGENT_TASK_DETERMINISTIC_ROUTING_ENABLED=false
AGENT_ITEM_COMPLETION_ENABLED=false
AGENT_TASK_REFUND_PREVIEW_ENABLED=false
AGENT_TASK_MAX_DECISIONS=3
AGENT_TASK_MAX_TOOL_CALLS=4
AGENT_TASK_TIMEOUT_SECONDS=20
AGENT_TASK_MAX_OUTPUT_TOKENS=256
# 通过模型/质量准入后，切换时另设显式策略版本，例如understanding.model-first.v2。

LLM_GENERATION_TEMPERATURE=0.7

CHAT_RUN_TIMEOUT_SECONDS=30

LLM_MAX_CONCURRENCY=8

EMBEDDING_TIMEOUT_SECONDS=90

EMBEDDING_DOCUMENT_TIMEOUT_SECONDS=90

# Online embedding timeout; document timeout is per batch HTTP, local admission deadlines still apply.
# CHAT_RUN_TIMEOUT_SECONDS bounds the full Run; LLM_GENERATION_TEMPERATURE applies only to generation.
